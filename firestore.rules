// firestore.rules — Regras de segurança do Firestore (JewelMaster)
//
// ⚠️ ATENÇÃO: este arquivo, sozinho, NÃO faz nada. Ele só existe aqui
// como cópia local. Para valer de verdade, o conteúdo precisa ser colado
// manualmente no Firebase Console (Firestore Database > aba "Regras" >
// Publicar).
//
// Política geral: tudo bloqueado por padrão. Cada sessão que criar uma
// coleção nova deve liberar essa coleção aqui, e republicar.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: true se quem está fazendo a requisição está
    // logada E o documento users/{uid} dela diz role == "admin".
    function ehAdminLogado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------- Coleção "users" ----------
    match /users/{uid} {

      // Qualquer pessoa logada pode ler o PRÓPRIO documento.
      allow read: if request.auth != null && request.auth.uid == uid;

      // A Admin pode ler o documento de qualquer usuária.
      allow read: if ehAdminLogado();

      // A pessoa pode ATUALIZAR o próprio documento, mas SOMENTE o campo "theme".
      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme']);

      // Acrescentado na Sessão 2: a Admin pode CRIAR o documento de uma
      // vendedora nova (depois do Worker criar o login dela no Authentication).
      allow create: if ehAdminLogado();

      allow delete: if false;
    }

    // ---------- Coleção "sellers" (liberada na Sessão 2) ----------
    match /sellers/{sellerId} {

      // A Admin pode ler, criar e atualizar qualquer vendedora.
      allow read, create, update: if ehAdminLogado();

      // A vendedora pode ler APENAS o próprio documento (onde userId
      // é igual ao uid de quem está logada) — não pode editar.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // ---------- Coleção "products" (liberada na Sessão 3) ----------
    match /products/{productId} {

      // Qualquer pessoa logada (Admin OU Vendedora) pode LER o catálogo
      // de produtos — necessário para as próximas sessões (Maletas,
      // Vendas), onde a vendedora precisa ver os produtos disponíveis.
      allow read: if request.auth != null;

      // Só a Admin pode criar ou atualizar produtos.
      allow create, update: if ehAdminLogado();

      // Sem exclusão, mesmo padrão das outras coleções — desativar um
      // produto é feito com o campo "active", nunca apagando o documento.
      allow delete: if false;
    }

    // ---------- Coleção "categories" (liberada no acréscimo da Sessão 3) ----------
    // Categorias de produto (ex.: "Anel", prefixo "AN"), usadas para
    // sugerir o código curto (shortCode) dos produtos.
    match /categories/{categoryId} {

      // Só a Admin pode ler, criar e editar categorias.
      allow read, create, update: if ehAdminLogado();

      // Sem exclusão por enquanto.
      allow delete: if false;
    }

    // ---------- Coleção "bags" (liberada na Sessão 4) ----------
    // Maletas. O campo sellerId guarda o UID (login) da vendedora, o mesmo
    // valor de request.auth.uid — por isso a regra da vendedora é direta.
    match /bags/{bagId} {

      // A Admin lê, cria e atualiza qualquer maleta.
      allow read, create, update: if ehAdminLogado();

      // A vendedora lê APENAS as maletas dela.
      allow read: if request.auth != null && resource.data.sellerId == request.auth.uid;

      allow delete: if false;
    }

    // ---------- Coleção "bagItems" (liberada na Sessão 4) ----------
    // Cada item guarda também sellerId (cópia do dono da maleta), para a
    // regra não precisar de consulta extra.
    match /bagItems/{bagItemId} {

      // A Admin lê, cria e atualiza qualquer item.
      allow read, create, update: if ehAdminLogado();

      // A vendedora lê APENAS itens de maletas dela. Ao consultar, a
      // vendedora deve filtrar também por sellerId == o próprio uid.
      allow read: if request.auth != null && resource.data.sellerId == request.auth.uid;

      allow delete: if false;
    }

    // ---------- Todas as outras coleções: bloqueadas até serem construídas ----------
    match /{colecaoQualquer}/{documentoQualquer} {
      allow read, write: if false;
    }
  }
}
